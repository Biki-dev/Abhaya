# Abhaya backend environment

# Required by Prisma and the backend database client.
# PostgreSQL example:
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/abhaya?schema=public

# HTTP server port. Optional; defaults to 4000.
PORT=4000

# Public URL where the trusted-contact web viewer is hosted.
# Used to generate share links for live safety sessions.
VIEWER_URL=https://abhayamain.netlify.app/

# Twilio SMS credentials. Required for police/contact SMS delivery.
# Keep these server-side only; never put them in the Expo frontend .env.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=replace_with_twilio_auth_token
TWILIO_FROM_NUMBER=+10000000000

# Optional fallback police contact number used when no nearby station number is available.
# Use E.164 format, for example +919876543210.
POLICE_FALLBACK_NUMBER=+919876543210
