# Abhaya frontend / Expo environment
# Copy to .env for local development. Never commit .env or real credentials.
# Expo exposes only variables prefixed with EXPO_PUBLIC_ to the app bundle.

# Backend API URL used by the mobile app.
# Optional: app.json already provides the production fallback.
EXPO_PUBLIC_API_BASE_URL=https://abhaya-backend.onrender.com

# Optional LAN backend URL for testing a physical Android/iOS device.
# Example: http://192.168.1.25:4000
# The device and computer must be on the same network.
EXPO_PUBLIC_LAN_API_BASE_URL=

# Public RevenueCat Test Store API keys.
# These are public client-side keys; use only Test Store keys here.
# Required when testing RevenueCat offerings/purchases locally.
EXPO_PUBLIC_REVENUECAT_TEST_APPLE_KEY=appl_test_public_key_here
EXPO_PUBLIC_REVENUECAT_TEST_GOOGLE_KEY=goog_test_public_key_here

# Public web viewer URL used when sharing a live safety session.
# Optional: the app has a production fallback URL.
EXPO_PUBLIC_VIEWER_URL=https://abhayamain.netlify.app/
